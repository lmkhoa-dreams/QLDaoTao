@model List<QLSinhVien.Models.GiayToSinhVien>

@{
    Layout = "~/Areas/SinhVien/Views/Shared/_SinhVienLayout.cshtml";
    ViewData["Title"] = "Hồ sơ sinh viên";
}

<div class="max-w-7xl mx-auto rounded-lg bg-white p-5 shadow-sm">

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 pb-4">
        <h1 class="text-xl font-bold text-gray-600">
            Hồ sơ sinh viên
        </h1>

        <a href="@Url.Action("Upload", "GiayTo", new { area = "" })"
           class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
            <i class="fa-solid fa-plus mr-1"></i>
            Upload giấy tờ
        </a>
    </div>

    <div class="mb-4 flex flex-wrap gap-5 text-sm text-gray-600">
        <span>
            <i class="fa-solid fa-circle mr-1 text-yellow-400"
               aria-hidden="true"></i>
            Chờ duyệt
        </span>

        <span>
            <i class="fa-solid fa-check mr-1 text-green-600"
               aria-hidden="true"></i>
            Đã duyệt
        </span>

        <span>
            <i class="fa-solid fa-xmark mr-1 text-red-600"
               aria-hidden="true"></i>
            Từ chối
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full min-w-[600px] border-collapse border border-gray-300 text-sm">
            <thead class="bg-gray-50 text-blue-500">
                <tr>
                    <th scope="col"
                        class="w-14 border border-gray-300 px-3 py-4">
                        STT
                    </th>
                    <th scope="col"
                        class="border border-gray-300 px-3 py-4">
                        Tên hồ sơ
                    </th>
                    <th scope="col"
                        class="w-36 border border-gray-300 px-3 py-4">
                        Trạng thái
                    </th>
                    <th scope="col"
                        class="w-24 border border-gray-300 px-3 py-4">
                        Thao tác
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4"
                            class="border border-gray-300 p-8 text-center text-gray-500">
                            Bạn chưa upload giấy tờ nào.
                        </td>
                    </tr>
                }

                @for (var i = 0; i < Model.Count; i++)
                {
                    var giayTo = Model[i];
                    var chiTietId = $"giayto-{giayTo.MaGiayTo}";

                    var duoiFile = System.IO.Path
                    .GetExtension(giayTo.DuongDan)
                    .ToLowerInvariant();

                    var laAnh = duoiFile == ".jpg"
                    || duoiFile == ".jpeg"
                    || duoiFile == ".png";

                    var urlXem = Url.Action(
                    "XemFile",
                    "GiayTo",
                    new { area = "", id = giayTo.MaGiayTo });

                    <tr class="hover:bg-blue-50">
                        <td class="border border-gray-300 px-3 py-3 text-center text-gray-500">
                            @(i + 1)
                        </td>

                        <td class="border border-gray-300 px-3 py-3 text-gray-600">
                            @giayTo.LoaiGiayTo
                        </td>

                        <td class="border border-gray-300 px-3 py-3 text-center">
                            @if (giayTo.TrangThai == "Chờ duyệt")
                            {
                                <span class="inline-flex items-center gap-2 text-yellow-700">
                                    <i class="fa-solid fa-circle text-yellow-400"
                                       aria-hidden="true"></i>
                                    Chờ duyệt
                                </span>
                            }
                            else if (giayTo.TrangThai == "Đã duyệt")
                            {
                                <span class="inline-flex items-center gap-2 text-green-600">
                                    <i class="fa-solid fa-check text-lg"
                                       aria-hidden="true"></i>
                                    Đã duyệt
                                </span>
                            }
                            else if (giayTo.TrangThai == "Từ chối")
                            {
                                <span class="inline-flex items-center gap-2 text-red-600">
                                    <i class="fa-solid fa-xmark text-lg"
                                       aria-hidden="true"></i>
                                    Từ chối
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-500">@giayTo.TrangThai</span>
                            }
                        </td>

                        <td class="border border-gray-300 px-3 py-3 text-center">
                            <button type="button"
                                    aria-expanded="false"
                                    aria-controls="@chiTietId"
                                    onclick="toggleGiayTo(this)"
                                    class="rounded border border-blue-200 bg-blue-50 px-3 py-1 text-blue-600 hover:bg-blue-100">
                                Xem
                            </button>
                        </td>
                    </tr>

                    <tr id="@chiTietId" hidden>
                        <td colspan="4"
                            class="border border-gray-300 bg-gray-50 p-4">

                            @if (giayTo.TrangThai == "Từ chối")
                            {
                                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-red-700">
                                    <p class="font-semibold">
                                        Lý do từ chối
                                    </p>
                                    <p class="mt-1 whitespace-pre-wrap break-words">@(string.IsNullOrWhiteSpace(giayTo.GhiChu) ? "Chưa có lý do được ghi nhận." : giayTo.GhiChu)</p>
                                </div>
                            }

                            <div class="mb-3 text-gray-600">
                                <p class="break-all">
                                    <strong>Tên file:</strong> @giayTo.TenFile
                                </p>
                                <p class="mt-1">
                                    <strong>Ngày gửi:</strong>
                                    @giayTo.NgayTaiLen.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>

                            @if (laAnh)
                            {
                                <a href="@urlXem"
                                   target="_blank"
                                   rel="noopener"
                                   class="block rounded-lg border border-gray-200 bg-white p-3">
                                    <img data-src="@urlXem"
                                         alt="@giayTo.LoaiGiayTo"
                                         class="mx-auto max-h-[600px] max-w-full rounded object-contain" />
                                </a>
                            }
                            else if (duoiFile == ".pdf")
                            {
                                <iframe data-src="@urlXem"
                                        title="Xem @giayTo.LoaiGiayTo"
                                        class="h-[600px] w-full rounded-lg border border-gray-200 bg-white">
                                </iframe>
                            }
                            else
                            {
                                <p class="text-gray-500">
                                    File này chưa hỗ trợ xem trực tiếp.
                                </p>
                            }

                            <div class="mt-3 flex gap-4">
                                @if (laAnh || duoiFile == ".pdf")
                                {
                                    <a href="@urlXem"
                                       target="_blank"
                                       rel="noopener"
                                       class="text-blue-600 hover:underline">
                                        Mở trong tab mới
                                    </a>
                                }

                                <a href="@Url.Action("TaiFile", "GiayTo", new { area = "", id = giayTo.MaGiayTo })"
                                   class="text-gray-600 hover:underline">
                                    Tải xuống
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleGiayTo(button) {
        const row = document.getElementById(
            button.getAttribute("aria-controls")
        );

        const opening = row.hidden;

        row.hidden = !opening;
        button.setAttribute("aria-expanded", String(opening));
        button.textContent = opening ? "Đóng" : "Xem";

        // Chỉ tải ảnh/PDF khi sinh viên bấm Xem.
        if (opening) {
            row.querySelectorAll("[data-src]").forEach(function (element) {
                element.src = element.dataset.src;
                element.removeAttribute("data-src");
            });
        }
    }
</script>