@model QLSinhVien.Models.GiangVien
@{
    ViewData["Title"] = "Cập Nhật Giảng Viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50/50 rounded-t-lg">
        <h2 class="text-lg font-bold text-gray-700">Cập nhật thông tin: <span class="text-blue-600">@Model.HoTen</span></h2>
        <a href="/Admin/GiangVien/Index" class="text-gray-500 hover:text-gray-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="m-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">
            @ViewBag.Error
        </div>
    }

    <div class="p-8">
        <form action="/Admin/GiangVien/Edit" method="post">

            <h3 class="text-sm font-bold text-blue-600 uppercase mb-4 tracking-wider">Thông tin Cơ bản</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mã Giảng Viên </label>
                    <input type="text" name="MaGV" value="@Model.MaGv" readonly class="w-full px-4 py-2.5 border border-gray-200 bg-gray-100 text-gray-500 rounded-md focus:outline-none text-sm cursor-not-allowed">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và Tên <span class="text-red-500">*</span></label>
                    <input type="text" name="HoTen" value="@Model.HoTen" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                    <input type="text" name="SoDienThoai" value="@Model.SoDienThoai" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" name="Email" value="@Model.Email" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>
            </div>

            <div class="flex justify-end pt-6 border-t border-gray-100 gap-3">
                <a href="/Admin/GiangVien/Index" class="px-6 py-2.5 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors font-medium text-sm text-decoration-none">Hủy bỏ</a>
                <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors font-medium text-sm shadow-sm flex items-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> Cập nhật dữ liệu
                </button>
            </div>

        </form>
    </div>
</div>