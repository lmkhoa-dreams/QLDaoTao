@model IEnumerable<QLSinhVien.Models.GiangVien>

@{
    ViewData["Title"] = "Quản lý Giảng viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Danh sách Giảng viên</h2>
    <a href="/Admin/GiangVien/Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow flex items-center">
        <i class="fa-solid fa-plus mr-2"></i> Thêm Giảng viên
    </a>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mã GV</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Họ và Tên</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số Điện Thoại</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Thao tác</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-blue-600">@item.MaGv</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">@item.HoTen</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.Email</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@item.SoDienThoai</td>
                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">

                            <!-- Nút Xem chi tiết (Con mắt) -->
                            <a href="/Admin/GiangVien/Details?id=@item.MaGv" class="text-green-600 hover:text-green-900 mx-2" title="Xem chi tiết">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <!-- Nút Sửa -->
                            <a href="/Admin/GiangVien/Edit?id=@item.MaGv" class="text-blue-600 hover:text-blue-900 mx-2" title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            <!-- Nút Xóa (Dùng form để bảo mật POST) -->
                            <form action="/Admin/GiangVien/Delete" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa giảng viên này không?');">
                                <input type="hidden" name="id" value="@item.MaGv" />
                                <button type="submit" class="text-red-600 hover:text-red-900 mx-2" title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-500">Chưa có dữ liệu giảng viên nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>