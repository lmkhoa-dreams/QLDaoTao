@model QLSinhVien.Models.GiangVien

@{
    ViewData["Title"] = "Chi Tiết Giảng Viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden mt-4">

    <!-- Header -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50/50">
        <h2 class="text-lg font-bold text-gray-700">Hồ sơ chi tiết: <span class="text-blue-600">@Model.HoTen</span></h2>
        <a href="/Admin/GiangVien/Index" class="text-gray-500 hover:text-blue-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách
        </a>
    </div>

    <div class="p-8">
        <div class="flex flex-col md:flex-row gap-10">

            <!-- Cột trái: Avatar -->
            <div class="flex flex-col w-full md:w-1/4">
                <div class="flex justify-center mb-6">
                    <!-- Tự động tạo Avatar xịn xò từ chữ cái đầu của Tên -->
                    <img src="https://ui-avatars.com/api/?name=@Model.HoTen&background=0D8ABC&color=fff&size=200"
                         alt="Avatar"
                         class="w-40 h-40 rounded-full object-cover shadow-sm border-2 border-gray-200" />
                </div>
                <div class="space-y-4 text-[14.5px] bg-gray-50 p-4 rounded-lg">
                    <div class="flex justify-between border-b pb-2">
                        <span class="text-gray-500">Mã GV:</span>
                        <span class="font-bold text-blue-700">@Model.MaGv</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Họ tên:</span>
                        <span class="font-bold text-gray-800 text-right">@Model.HoTen</span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin liên hệ & Công tác -->
            <div class="flex-1">
                <h2 class="text-[22px] font-bold text-gray-700 mb-6 border-b pb-2">Thông tin công tác & Liên hệ</h2>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-6 gap-x-6 text-[15px] mt-6">

                    <!-- Thông tin fix cứng làm màu cho đẹp UI -->
                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-briefcase mr-2"></i> Trạng thái:</span>
                        <span class="font-bold text-green-700 bg-green-100 px-3 py-1 rounded-full text-xs">Đang công tác</span>
                    </div>

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-user-tie mr-2"></i> Chức vụ:</span>
                        <span class="font-bold text-gray-800">Giảng viên</span>
                    </div>

                    <!-- Dữ liệu thật từ DB -->
                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-phone mr-2"></i> Điện thoại:</span>
                        <span class="font-bold text-gray-800">
                            @(string.IsNullOrEmpty(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)
                        </span>
                    </div>

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-envelope mr-2"></i> Email:</span>
                        <span class="font-bold text-gray-800">
                            @(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)
                        </span>
                    </div>
                </div>

                <div class="mt-10 bg-blue-50 border border-blue-100 rounded-lg p-5">
                    <h3 class="text-sm font-bold text-blue-800 mb-2"><i class="fa-solid fa-circle-info mr-1"></i> Thông tin hệ thống</h3>
                    <p class="text-sm text-gray-600">Tài khoản đăng nhập của giảng viên được cấp mặc định theo Mã GV. Giảng viên sử dụng tài khoản này để đăng nhập vào cổng thông tin nội bộ của nhà trường.</p>
                </div>
            </div>
        </div>
    </div>
</div>