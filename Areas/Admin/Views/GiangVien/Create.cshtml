@model QLSinhVien.Models.GiangVien
@{
    ViewData["Title"] = "Thêm Giảng Viên Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50/50 rounded-t-lg">
        <h2 class="text-lg font-bold text-gray-700">Nhập thông tin Giảng viên</h2>
        <a href="/Admin/GiangVien/Index" class="text-gray-500 hover:text-blue-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="m-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">
            @ViewBag.Error
        </div>
    }

    <div class="p-8">
        <form action="/Admin/GiangVien/Create" method="post">

            <h3 class="text-sm font-bold text-blue-600 uppercase mb-4 tracking-wider">Thông tin Cơ bản</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mã Giảng Viên <span class="text-red-500">*</span></label>
                    <input type="text" name="MaGV" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="Nhập MSGV (VD: GV001)">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và Tên <span class="text-red-500">*</span></label>
                    <input type="text" name="HoTen" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="VD: Nguyễn Văn A">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                    <input type="text" name="SoDienThoai" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="VD: 0987654321">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" name="Email" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="VD: email@truong.edu.vn">
                </div>
            </div>

            <div class="flex flex-col mb-4">
                <label class="font-bold text-gray-700 mb-2">Khoa trực thuộc <span class="text-red-500">*</span></label>
                <select name="TenKhoa" class="border border-gray-300 rounded p-2 focus:outline-none focus:border-blue-500" required>
                    <option value="">-- Chọn khoa --</option>
                    <!-- Tự động lặp qua ViewBag để in ra các dòng option -->
                    @if (ViewBag.DanhSachKhoa != null)
                    {
                        foreach (var item in ViewBag.DanhSachKhoa)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Nút Lưu -->
            <div class="flex justify-end pt-6 border-t border-gray-100 gap-3">
                <a href="/Admin/GiangVien/Index" class="px-6 py-2.5 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors font-medium text-sm text-decoration-none">Hủy bỏ</a>
                <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors font-medium text-sm shadow-sm flex items-center">
                    <i class="fa-solid fa-plus mr-2"></i> Thêm Giảng viên
                </button>
            </div>

        </form>
    </div>
</div>