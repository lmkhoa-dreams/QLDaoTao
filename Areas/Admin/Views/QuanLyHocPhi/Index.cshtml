@model IEnumerable<QLSinhVien.Areas.Admin.Controllers.HocPhiViewModel>
@{
    ViewData["Title"] = "Quản lý Học phí";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    long tongDoanhThu = Model.Where(x => x.TrangThai == "Đã thanh toán").Sum(x => x.TongTien);
    long tongCongNo = Model.Where(x => x.TrangThai == "Chờ thanh toán").Sum(x => x.TongTien);
}

<div class="mb-6 flex justify-between items-start">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Quản lý Công nợ & Học phí</h2>
    </div>

    <!-- BỘ LỌC HỌC KỲ CHO ADMIN -->
    <div>
        <form id="formHocKyAdmin" action="/Admin/QuanLyHocPhi/Index" method="get">
            <select name="hocKy" onchange="document.getElementById('formHocKyAdmin').submit()" class="border border-blue-300 bg-blue-50 text-blue-800 rounded-lg px-4 py-2 min-w-[200px] focus:outline-none focus:ring-2 focus:ring-blue-500 font-bold cursor-pointer shadow-sm">
                @if (ViewBag.DsHocKy != null)
                {
                    foreach (var hk in ViewBag.DsHocKy)
                    {
                        <option value="@hk" selected="@(ViewBag.HocKyHienTai == hk ? "selected" : null)">@hk</option>
                    }
                }
            </select>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6 flex items-center shadow-sm">
        <i class="fa-solid fa-check-circle text-lg mr-2"></i> <strong>@TempData["Success"]</strong>
    </div>
}

<!-- THỐNG KÊ NHANH -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500 flex items-center justify-between">
        <div>
            <p class="text-sm text-gray-500 font-bold mb-1">TỔNG THỰC THU</p>
            <h3 class="text-2xl font-black text-green-600">@tongDoanhThu.ToString("N0") VNĐ</h3>
        </div>
        <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center text-green-500 text-xl">
            <i class="fa-solid fa-sack-dollar"></i>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-orange-500 flex items-center justify-between">
        <div>
            <p class="text-sm text-gray-500 font-bold mb-1">TỔNG CÔNG NỢ (CHƯA THU)</p>
            <h3 class="text-2xl font-black text-orange-500">@tongCongNo.ToString("N0") VNĐ</h3>
        </div>
        <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-orange-400 text-xl">
            <i class="fa-solid fa-file-invoice"></i>
        </div>
    </div>
</div>

<!-- BẢNG DANH SÁCH SINH VIÊN -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-sm text-left">
        <thead class="bg-gray-50 text-gray-700 border-b">
            <tr>
                <th class="p-4 text-center w-12">STT</th>
                <th class="p-4">MSSV</th>
                <th class="p-4">Họ và Tên</th>
                <th class="p-4">Lớp Sinh Hoạt</th>
                <th class="p-4 text-center">Tổng TC</th>
                <th class="p-4 text-right">Tổng học phí</th>
                <th class="p-4 text-center">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }
            @foreach (var item in Model)
            {
                bool daThu = item.TrangThai == "Đã thanh toán";
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                    <td class="p-4 text-center font-medium text-gray-500">@(stt++)</td>
                    <td class="p-4 font-bold text-blue-600">@item.Mssv</td>
                    <td class="p-4 font-bold text-gray-800">@item.HoTen</td>
                    <td class="p-4 text-gray-600">@item.MaLop</td>
                    <td class="p-4 text-center font-medium text-gray-800">@item.TongTinChi</td>
                    <td class="p-4 text-right font-bold text-red-600">@item.TongTien.ToString("N0") đ</td>
                    <td class="p-4 text-center">
                        @if (daThu)
                        {
                            <span class="inline-block px-3 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full">Đã thanh toán</span>
                        }
                        else
                        {
                            <span class="inline-block px-3 py-1 bg-orange-100 text-orange-600 text-xs font-bold rounded-full">Chờ thanh toán</span>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr><td colspan="7" class="p-8 text-center text-gray-500">Không có dữ liệu đăng ký nào trong học kỳ này.</td></tr>
            }
        </tbody>
    </table>
</div>