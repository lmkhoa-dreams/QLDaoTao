@model QLSinhVien.Models.MonHoc
@{
    ViewData["Title"] = "Cập Nhật Môn Học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="bg-white rounded-lg shadow-sm border border-gray-100 max-w-3xl mx-auto">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50/50 rounded-t-lg">
        <h2 class="text-lg font-bold text-gray-700">Sửa Môn: <span class="text-blue-600">@Model.MaMon</span></h2>
        <a href="/Admin/MonHoc/Index" class="text-gray-500 hover:text-blue-700 text-sm font-medium"><i class="fa-solid fa-arrow-left mr-1"></i> Quay lại</a>
    </div>
    @if (ViewBag.Error != null)
    {
        <div class="m-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">@ViewBag.Error</div>
    }
    <div class="p-8">
        <form action="/Admin/MonHoc/Edit" method="post">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mã Môn (Không thể sửa)</label>
                    <input type="text" name="MaMon" value="@Model.MaMon" readonly class="w-full px-4 py-2.5 border border-gray-200 bg-gray-100 text-gray-500 rounded-md cursor-not-allowed">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số Tín Chỉ <span class="text-red-500">*</span></label>
                    <input type="number" name="SoTinChi" value="@Model.SoTinChi" min="1" max="10" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-blue-500">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tên Môn Học <span class="text-red-500">*</span></label>
                    <input type="text" name="TenMon" value="@Model.TenMon" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-blue-500">
                </div>
            </div>
            <div class="flex justify-end pt-4 border-t border-gray-100">
                <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-medium text-sm"><i class="fa-solid fa-save mr-2"></i> Cập nhật</button>
            </div>
        </form>
    </div>
</div>