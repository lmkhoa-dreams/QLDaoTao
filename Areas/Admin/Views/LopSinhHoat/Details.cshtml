@model QLSinhVien.Models.LopSinhHoat

@{
    ViewData["Title"] = "Chi Tiết Lớp Sinh Hoạt";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden mt-4">

    <!-- Header -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50/50">
        <h2 class="text-lg font-bold text-gray-700">Thông tin chi tiết Lớp: <span class="text-blue-600">@Model.TenLop</span></h2>
        <a href="/Admin/LopSinhHoat/Index" class="text-gray-500 hover:text-blue-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách
        </a>
    </div>

    <div class="p-8">
        <div class="flex flex-col md:flex-row gap-10">

            <!-- Cột trái: Icon minh họa -->
            <div class="flex flex-col w-full md:w-1/4 items-center">
                <div class="w-32 h-32 bg-blue-100 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-blue-50">
                    <i class="fa-solid fa-chalkboard-user text-5xl text-blue-500"></i>
                </div>
                <div class="text-center">
                    <span class="block font-bold text-gray-800 text-lg">@Model.MaLopSh</span>
                    <span class="block text-gray-500 text-sm mt-1">Mã định danh lớp</span>
                </div>
            </div>

            <!-- Cột phải: Thông tin Lớp -->
            <div class="flex-1">
                <h2 class="text-[22px] font-bold text-gray-700 mb-6 border-b pb-2">Hồ sơ Lớp sinh hoạt</h2>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-6 gap-x-6 text-[15px] mt-6">

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-layer-group mr-2"></i> Tên Lớp:</span>
                        <span class="font-bold text-gray-800">@Model.TenLop</span>
                    </div>

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-calendar-days mr-2"></i> Niên Khóa:</span>
                        <span class="font-bold text-indigo-700 bg-indigo-50 px-3 py-1 rounded-md text-sm border border-indigo-100">@Model.NienKhoa</span>
                    </div>

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-graduation-cap mr-2"></i> Ngành đào tạo:</span>
                        <span class="font-bold text-gray-800">@Model.TenNganh</span>
                    </div>

                    <div class="flex items-center">
                        <span class="text-gray-500 w-36 shrink-0"><i class="fa-solid fa-building-columns mr-2"></i> Khoa quản lý:</span>
                        <span class="font-bold text-gray-800">@Model.TenKhoa</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>