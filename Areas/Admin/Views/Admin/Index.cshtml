@{
    ViewData["Title"] = "Quản lý Sinh viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100">

    <div class="p-6 border-b border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <a href="/Admin/Admin/Create" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-md font-medium text-sm flex items-center transition-colors shadow-sm text-decoration-none">
            <i class="fa-solid fa-plus mr-2"></i> Thêm Sinh Viên
        </a>

        <div class="relative">
            <input type="text" placeholder="Tìm kiếm MSSV, Họ tên..."
                   class="pl-10 pr-4 py-2.5 border border-gray-300 rounded-md w-full md:w-80 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 text-gray-600 text-sm border-b border-gray-200">
                    <th class="py-3 px-6 font-semibold w-24">MSSV</th>
                    <th class="py-3 px-6 font-semibold">Họ và Tên</th>
                    <th class="py-3 px-6 font-semibold">Ngày sinh</th>
                    <th class="py-3 px-6 font-semibold">Giới tính</th>
                    <th class="py-3 px-6 font-semibold">Lớp sinh hoạt</th>
                    <th class="py-3 px-6 font-semibold">Trạng thái</th>
                    <th class="py-3 px-6 font-semibold text-center w-40">Thao tác</th>
                </tr>
            </thead>
            <tbody class="text-sm text-gray-700 divide-y divide-gray-100">

                @if (ViewBag.DanhSachSV != null)
                {
                    foreach (var sv in ViewBag.DanhSachSV)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-6 font-medium text-blue-600">@sv.Mssv</td>
                            <td class="py-3 px-6 font-bold text-gray-800">@sv.HoTen</td>
                            <td class="py-3 px-6">@sv.NgaySinh.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 px-6">@(sv.GioiTinh ? "Nam" : "Nữ")</td>
                            <td class="py-3 px-6">@sv.TenLop</td>

                            <!-- BẮT ĐẦU PHẦN ĐỔI MÀU TRẠNG THÁI TỰ ĐỘNG -->
                            <td class="py-3 px-6">
                                @{
                                    string badgeClass = "bg-gray-100 text-gray-800";
                                    switch (sv.TrangThaiHocTap)
                                    {
                                        case "Đang học":
                                            badgeClass = "bg-green-100 text-green-700";
                                            break;
                                        case "Bảo lưu":
                                            badgeClass = "bg-blue-100 text-blue-700";
                                            break;
                                        case "Đã tốt nghiệp":
                                            badgeClass = "bg-yellow-100 text-yellow-700";
                                            break;
                                        case "Đình chỉ":
                                            badgeClass = "bg-red-100 text-red-700";
                                            break;
                                    }
                                }
                                <span class="@badgeClass px-3 py-1 rounded-full text-xs font-medium inline-block">
                                    @sv.TrangThaiHocTap
                                </span>
                            </td>

                            <td class="py-3 px-6 flex justify-center items-center gap-4">
                                <!-- NÚT MỚI: Xem Chi Tiết -->
                                <a href="/Admin/Admin/Details?id=@sv.Mssv" class="text-emerald-500 hover:text-emerald-700 transition-colors" title="Xem chi tiết">
                                    <i class="fa-solid fa-eye text-lg"></i>
                                </a>
                                <!-- Nút Sửa -->
                                <a href="/Admin/Admin/Edit?id=@sv.Mssv" class="text-blue-500 hover:text-blue-700 transition-colors" title="Chỉnh sửa">
                                    <i class="fa-regular fa-pen-to-square text-lg"></i>
                                </a>
                                <!-- Nút Xóa -->
                                <form action="/Admin/Admin/Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này cùng toàn bộ dữ liệu liên quan?');" class="m-0 p-0">
                                    <input type="hidden" name="id" value="@sv.Mssv" />
                                    <button type="submit" class="text-red-500 hover:text-red-700 transition-colors bg-transparent border-0 p-0 cursor-pointer" title="Xóa">
                                        <i class="fa-regular fa-trash-can text-lg"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="p-4 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
        <div class="flex gap-1">
            <button class="px-3 py-1 border border-gray-300 rounded hover:bg-gray-50 text-gray-400 cursor-not-allowed">Trước</button>
            <button class="px-3 py-1 border border-blue-500 bg-blue-50 text-blue-600 rounded font-medium">1</button>
            <button class="px-3 py-1 border border-gray-300 rounded hover:bg-gray-50">Sau</button>
        </div>
    </div>
</div>