@{
    ViewData["Title"] = "Chi Tiết Sinh Viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">

    <!-- Header -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-emerald-50/50">
        <h2 class="text-lg font-bold text-gray-700">Hồ sơ chi tiết: <span class="text-emerald-600">@ViewBag.HoTen</span></h2>
        <a href="/Admin/Admin/Index" class="text-gray-500 hover:text-gray-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách
        </a>
    </div>

    <div class="p-8">
        <div class="flex flex-col md:flex-row gap-10">
            <!-- Cột trái: Avatar -->
            <div class="flex flex-col w-full md:w-1/4">
                <div class="flex justify-center mb-6">
                    <img src="https://ui-avatars.com/api/?name=@ViewBag.HoTen&background=random&size=200"
                         alt="Avatar"
                         class="w-40 h-40 rounded-full object-cover shadow-sm border-2 border-gray-200" />
                </div>
                <div class="space-y-4 text-[14.5px]">
                    <div class="flex"><span class="text-gray-500 w-24 shrink-0">MSSV:</span> <span class="font-bold text-gray-800">@ViewBag.MSSV</span></div>
                    <div class="flex"><span class="text-gray-500 w-24 shrink-0">Họ tên:</span> <span class="font-bold text-gray-800">@ViewBag.HoTen</span></div>
                    <div class="flex"><span class="text-gray-500 w-24 shrink-0">Giới tính:</span> <span class="font-bold text-gray-800">@ViewBag.GioiTinh</span></div>
                </div>
            </div>

            <!-- Cột phải: Học vấn -->
            <div class="flex-1">
                <h2 class="text-[22px] font-bold text-gray-700 mb-6">Thông tin học vấn</h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-5 gap-x-6 text-[14.5px]">
                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Trạng thái:</span> <span class="font-bold text-gray-800">@ViewBag.TrangThai</span></div>
                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Mã hồ sơ:</span> <span class="font-bold text-gray-800">@ViewBag.MaHoSo</span></div>

                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Lớp học:</span> <span class="font-bold text-gray-800">@ViewBag.Lop</span></div>
                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Ngày vào trường:</span> <span class="font-bold text-gray-800">@ViewBag.NgayVaoTruong</span></div>

                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Bậc đào tạo:</span> <span class="font-bold text-gray-800">Đại học</span></div>
                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Loại hình:</span> <span class="font-bold text-gray-800">Chính quy</span></div>

                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Khoa:</span> <span class="font-bold text-gray-800">@ViewBag.Khoa</span></div>
                    <div class="flex"><span class="text-gray-500 w-36 shrink-0">Khóa học:</span> <span class="font-bold text-gray-800">@ViewBag.KhoaHoc</span></div>

                    <div class="flex lg:col-span-2"><span class="text-gray-500 w-36 shrink-0">Ngành học:</span> <span class="font-bold text-gray-800">@ViewBag.Nganh</span></div>
                </div>
            </div>
        </div>

        <div class="border-b border-gray-200 my-10"></div>

        <div>
            <h2 class="text-[22px] font-bold text-gray-700 mb-6">Thông tin cá nhân</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-5 gap-x-6 text-[14.5px]">
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Ngày sinh:</span> <span class="font-bold text-gray-800">@ViewBag.NgaySinh</span></div>
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Số CCCD:</span> <span class="font-bold text-gray-800">@ViewBag.CCCD</span></div>

                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Dân tộc:</span> <span class="font-bold text-gray-800">@ViewBag.DanToc</span></div>
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Ngày cấp:</span> <span class="font-bold text-gray-800">@ViewBag.NgayCap</span></div>

                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Tôn giáo:</span> <span class="font-bold text-gray-800">@ViewBag.TonGiao</span></div>
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Nơi cấp:</span> <span class="font-bold text-gray-800">@ViewBag.NoiCap</span></div>

                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Quốc tịch:</span> <span class="font-bold text-gray-800">@ViewBag.QuocTich</span></div>
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Khu vực ưu tiên:</span> <span class="font-bold text-gray-800">@ViewBag.KhuVuc</span></div>

                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Điện thoại:</span> <span class="font-bold text-gray-800">@ViewBag.DienThoai</span></div>
                <div class="flex"><span class="text-gray-500 w-36 shrink-0">Nơi sinh:</span> <span class="font-bold text-gray-800">@ViewBag.NoiSinh</span></div>

                <div class="flex lg:col-span-2"><span class="text-gray-500 w-36 shrink-0">Email:</span> <span class="font-bold text-gray-800">@ViewBag.EmailCaNhan</span></div>
                <div class="flex lg:col-span-2"><span class="text-gray-500 w-36 shrink-0">Email Trường:</span> <span class="font-bold text-gray-800">@ViewBag.EmailTruong</span></div>

                <div class="flex lg:col-span-2"><span class="text-gray-500 w-36 shrink-0">Hộ khẩu:</span> <span class="font-bold text-gray-800">@ViewBag.HoKhau</span></div>
                <div class="flex lg:col-span-2"><span class="text-gray-500 w-36 shrink-0">Địa chỉ liên hệ:</span> <span class="font-bold text-gray-800">@ViewBag.DiaChi</span></div>
            </div>
        </div>
    </div>
</div>