@model QLSinhVien.Models.SinhVien
@{
    ViewData["Title"] = "Thêm Sinh Viên Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-lg">
        <h2 class="text-lg font-bold text-gray-700">Nhập thông tin Sinh viên</h2>
        <a href="/Admin/Admin/Index" class="text-gray-500 hover:text-gray-700 text-sm font-medium flex items-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="m-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">
            @ViewBag.Error
        </div>
    }

    <div class="p-8">
        <form action="/Admin/Admin/Create" method="post">

            <h3 class="text-sm font-bold text-blue-600 uppercase mb-4 tracking-wider">Thông tin Cơ bản</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mã Sinh Viên <span class="text-red-500">*</span></label>
                    <input type="text" name="Mssv" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="Nhập MSSV (VD: 240001)">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Họ và Tên <span class="text-red-500">*</span></label>
                    <input type="text" name="HoTen" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="VD: Nguyễn Văn A">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Ngày sinh <span class="text-red-500">*</span></label>
                    <input type="date" name="NgaySinh" required class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Giới tính <span class="text-red-500">*</span></label>
                    <select name="GioiTinh" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm bg-white">
                        <option value="true">Nam</option>
                        <option value="false">Nữ</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Lớp sinh hoạt <span class="text-red-500">*</span></label>
                    @Html.DropDownList("MaLopSh", null, "--- Chọn lớp sinh hoạt ---", new { @class = "w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm bg-white", @required = "required" })
                </div>


                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mã Hồ Sơ</label>
                    <input type="text" name="MaHoSo" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                    <input type="text" name="SoDienThoai" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="text" name="EmailCaNhan" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>
            </div>

            <hr class="border-gray-100 mb-6">
            <h3 class="text-sm font-bold text-blue-600 uppercase mb-4 tracking-wider">Hồ sơ cá nhân chi tiết</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Số CCCD</label>
                    <input type="text" name="Cccd" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Ngày cấp</label>
                        <input type="date" name="NgayCap" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nơi cấp</label>
                        <input type="text" name="NoiCap" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="VD: Cục Cảnh sát...">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Dân tộc</label>
                        <input type="text" name="DanToc" value="Kinh" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tôn giáo</label>
                        <input type="text" name="TonGiao" value="Không" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nơi sinh (Tỉnh/Thành phố)</label>
                    <input type="text" name="NoiSinh" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Khu vực ưu tiên</label>
                    <input type="text" name="KhuVuc" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ liên hệ</label>
                    <input type="text" name="DiaChiLienHe" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Hộ khẩu thường trú</label>
                    <input type="text" name="HoKhauThuongTru" class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm">
                </div>
            </div>

            <!-- Nút Lưu -->
            <div class="flex justify-end pt-6 border-t border-gray-100 gap-3">
                <a href="/Admin/Admin/Index" class="px-6 py-2.5 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors font-medium text-sm text-decoration-none">Hủy bỏ</a>
                <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors font-medium text-sm shadow-sm flex items-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> Lưu dữ liệu
                </button>
            </div>

        </form>
    </div>
</div>