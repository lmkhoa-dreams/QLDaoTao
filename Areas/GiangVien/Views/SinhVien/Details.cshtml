@model QLSinhVien.Models.SinhVien
@{
    ViewData["Title"] = "Hồ sơ Sinh viên";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-100 max-w-4xl mx-auto mt-4">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-emerald-50/50">
        <h2 class="text-lg font-bold text-gray-700">Thông tin chi tiết Sinh viên</h2>
        <!-- Nút Back browser để quay lại đúng lớp đang xem -->
        <button onclick="history.back()" class="text-gray-500 hover:text-emerald-700 text-sm font-medium transition-colors">
            <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại danh sách lớp
        </button>
    </div>

    <div class="p-8">
        <div class="flex flex-col md:flex-row gap-10">
            <!-- Cột trái: Ảnh thẻ & Tên -->
            <div class="flex flex-col w-full md:w-1/3 items-center">
                <div class="w-40 h-40 bg-slate-100 rounded-full flex items-center justify-center mb-6 shadow-inner border-4 border-white overflow-hidden">
                    <i class="fa-solid fa-user-graduate text-6xl text-slate-300"></i>
                </div>
                <div class="text-center w-full">
                    <!-- CHỮ MSSV ĐƯỢC GIỮ LẠI ĐÂY NHA -->
                    <span class="block font-bold text-emerald-600 text-xl mb-1">MSSV: @Model.Mssv</span>
                    <span class="block text-gray-800 font-bold text-2xl">@Model.HoTen</span>
                    <span class="inline-block mt-3 px-4 py-1 bg-green-100 text-green-700 text-xs font-bold rounded-full uppercase tracking-wider">
                        @Model.TrangThaiHocTap
                    </span>
                </div>
            </div>

            <!-- Cột phải: Thông tin -->
            <div class="flex-1">
                <h3 class="text-sm font-bold text-emerald-600 uppercase mb-4 tracking-wider border-b border-gray-100 pb-2">Lý lịch cá nhân</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-6 text-[15px] mb-8">
                    <div class="flex flex-col">
                        <span class="text-gray-400 text-xs uppercase mb-1">Ngày sinh</span>
                        <span class="font-bold text-gray-800">@Model.NgaySinh.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-gray-400 text-xs uppercase mb-1">Giới tính</span>
                        <span class="font-bold text-gray-800">@(Model.GioiTinh ? "Nam" : "Nữ")</span>
                    </div>
                </div>

                <h3 class="text-sm font-bold text-emerald-600 uppercase mb-4 tracking-wider border-b border-gray-100 pb-2">Thông tin đào tạo</h3>

                <!-- Đưa về lại 1 cột cho Lớp sinh hoạt -->
                <div class="grid grid-cols-1 gap-4 text-[15px]">
                    <!-- Ô Lớp sinh hoạt -->
                    <div class="flex items-center p-3 bg-slate-50 rounded-lg border border-slate-100">
                        <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-500 flex items-center justify-center mr-4 shrink-0">
                            <i class="fa-solid fa-building"></i>
                        </div>
                        <div>
                            <span class="block text-gray-500 text-xs mb-0.5">Lớp sinh hoạt</span>
                            <span class="font-bold text-gray-800">@Model.MaLopSh</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>