@model List<QLSinhVien.Areas.GiangVien.Controllers.ChiTietDiemViewModel>
@{
    ViewData["Title"] = "Nhập điểm sinh viên";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
    var lopHp = ViewBag.LopHocPhan as QLSinhVien.Models.HocPhanMo;
}

<!-- CSS  -->
<style>
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }

    .excel-input {
        width: 100%;
        height: 100%;
        border: none !important;
        outline: none !important;
        text-align: center;
        background-color: transparent;
        padding: 10px 4px;
        font-weight: 500;
        box-shadow: none !important;
    }
    .excel-input:focus {
        background-color: #d1fae5;
    }
    .table-excel th, .table-excel td {
        border: 1px solid #cbd5e1 !important;
    }
</style>

@if (TempData["SuccessMsg"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 shadow-sm">
        <i class="fa-solid fa-check-circle mr-2"></i>@TempData["SuccessMsg"]
    </div>
}

<div class="bg-white rounded shadow border border-gray-300">
    <div class="p-4 border-b border-gray-300 flex justify-between items-center bg-gray-50">
        <div>
            <h2 class="text-lg font-bold text-gray-800 uppercase">Nhập điểm: @ViewBag.TenMon</h2>
            <p class="text-sm text-gray-600 mt-1">Lớp Học Phần: <b>@lopHp?.MaHp</b></p>
        </div>
        <a href="/GiangVien/Diem/Index" class="text-sm font-semibold text-gray-600 hover:text-emerald-600 border px-3 py-1.5 rounded bg-white shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Trở về
        </a>
    </div>

    <form action="/GiangVien/Diem/LuuDiem" method="post" class="p-6">
        <input type="hidden" name="maHp" value="@lopHp?.MaHp" />
        
        <div class="overflow-x-auto mb-6 border-t-2 border-t-emerald-600">
            <table class="w-full text-left border-collapse table-excel">
                <thead>
                    <tr class="bg-slate-100 text-gray-700 text-sm">
                        <th class="py-2 px-3 font-bold w-12 text-center align-middle">STT</th>
                        <th class="py-2 px-3 font-bold w-32 text-center align-middle">MSSV</th>
                        <th class="py-2 px-3 font-bold align-middle">Họ và Tên</th>
                        <th class="py-2 px-1 font-bold text-center w-32 text-emerald-700 align-middle">Quá trình <br/><span class="text-xs font-normal">(20%)</span></th>
                        <th class="py-2 px-1 font-bold text-center w-32 text-emerald-700 align-middle">Giữa kỳ <br/><span class="text-xs font-normal">(30%)</span></th>
                        <th class="py-2 px-1 font-bold text-center w-32 text-emerald-700 align-middle">Cuối kỳ <br/><span class="text-xs font-normal">(50%)</span></th>
                    </tr>
                </thead>
                <tbody class="text-[15px] text-gray-800">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr class="hover:bg-gray-50 transition-colors h-10">
                            <td class="text-center bg-gray-50 text-gray-500 font-medium p-0">@(i + 1)</td>
                            <td class="font-bold text-emerald-700 text-center p-0">
                                @Model[i].Mssv
                                <input type="hidden" name="danhSachDiem[@i].Id" value="@Model[i].Id" />
                                <input type="hidden" name="danhSachDiem[@i].Mssv" value="@Model[i].Mssv" />
                            </td>
                            <td class="font-semibold px-3 py-0">@Model[i].HoTen</td>
                            
                            <!-- 3 CỘT NHẬP ĐIỂM (EXCEL STYLE) -->
                            <td class="p-0 text-center relative">
                                <input type="number" step="0.1" min="0" max="10" name="danhSachDiem[@i].DiemQuaTrinh" value="@Model[i].DiemQuaTrinh" class="excel-input" />
                            </td>
                            <td class="p-0 text-center relative">
                                <input type="number" step="0.1" min="0" max="10" name="danhSachDiem[@i].DiemGiuaKy" value="@Model[i].DiemGiuaKy" class="excel-input" />
                            </td>
                            <td class="p-0 text-center relative">
                                <input type="number" step="0.1" min="0" max="10" name="danhSachDiem[@i].DiemThi" value="@Model[i].DiemThi" class="excel-input" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex justify-end">
            <button type="submit" class="bg-[#00985f] hover:bg-[#007f4f] text-white font-bold py-2 px-6 rounded shadow flex items-center transition-colors">
                <i class="fa-solid fa-floppy-disk mr-2"></i> Lưu Điểm Số
            </button>
        </div>
    </form>
</div>