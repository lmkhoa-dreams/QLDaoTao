@model IEnumerable<QLSinhVien.Models.HocPhanMo>
@{
    ViewData["Title"] = "Quản lý Điểm số";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
    var tuDien = ViewBag.TuDienMonHoc as Dictionary<string, string>;
}

<div class="mb-6 flex justify-between items-start">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Chọn lớp để nhập điểm</h2>
        <p class="text-gray-500 text-sm mt-1">Danh sách các lớp học phần được phân công</p>
    </div>

    <!-- BỘ LỌC HỌC KỲ CHO GIẢNG VIÊN -->
    <div>
        <form id="formHocKyGV" action="/GiangVien/Diem/Index" method="get">
            <select name="hocKy" onchange="document.getElementById('formHocKyGV').submit()" class="border border-emerald-300 bg-emerald-50 text-emerald-800 rounded-lg px-4 py-2 min-w-[200px] focus:outline-none focus:ring-2 focus:ring-emerald-500 font-bold cursor-pointer shadow-sm">
                @if (ViewBag.DsHocKy != null)
                {
                    foreach (var hk in ViewBag.DsHocKy)
                    {
                        <option value="@hk" selected="@(ViewBag.HocKyHienTai == hk ? "selected" : null)">@hk</option>
                    }
                }
            </select>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @if (Model != null && Model.Any())
    {
        foreach (var lop in Model)
        {
            string tenMon = tuDien != null && tuDien.ContainsKey(lop.MaMon) ? tuDien[lop.MaMon] : "Không xác định";

            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow relative overflow-hidden flex flex-col h-full">
                <div class="absolute top-0 left-0 w-1.5 h-full bg-emerald-500"></div>

                <div class="flex-1 ml-2">
                    <div class="flex justify-between items-start mb-4">
                        <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full">
                            <i class="fa-regular fa-calendar mr-1"></i> @lop.HocKy
                        </span>
                        <div class="w-8 h-8 rounded bg-gray-50 flex items-center justify-center text-gray-400">
                            <i class="fa-solid fa-laptop-code"></i>
                        </div>
                    </div>

                    <h3 class="text-xl font-bold text-gray-800 mb-4 line-clamp-2">@tenMon</h3>

                    <div class="space-y-1 mb-6 text-sm bg-gray-50 p-3 rounded-lg">
                        <p class="flex justify-between"><span class="text-gray-500">Mã Học Phần:</span> <span class="font-bold">@lop.MaHp</span></p>
                        <p class="flex justify-between"><span class="text-gray-500">Mã Môn:</span> <span class="font-bold text-emerald-600">@lop.MaMon</span></p>
                    </div>
                </div>

                <div class="flex items-center justify-between ml-2 mt-auto border-t border-gray-50 pt-4">
                    <div class="text-sm">
                        <span class="text-gray-500">Sĩ số:</span> <span class="font-bold">@lop.SiSoHienTai / @lop.SiSoToiDa</span>
                    </div>
                    <a href="/GiangVien/Diem/NhapDiem?id=@lop.MaHp" class="text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-lg transition-colors flex items-center">
                        Xem chi tiết <i class="fa-solid fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-span-full bg-gray-50 border border-gray-200 rounded-lg p-10 text-center text-gray-500">
            <i class="fa-solid fa-folder-open text-4xl mb-3 text-gray-300"></i>
            <p class="font-medium text-lg">Giảng viên không có lớp học phần nào trong học kỳ này.</p>
        </div>
    }
</div>