@model IEnumerable<QLSinhVien.Models.HocPhanMo>
@{
    ViewData["Title"] = "Chọn lớp điểm danh";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<h2 class="text-2xl font-bold text-gray-700 mb-6 border-b pb-3"><i class="fa-solid fa-clipboard-user mr-2 text-blue-600"></i> Quản lý Điểm danh</h2>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var lop in Model)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-3">
                <div>
                    <h3 class="font-bold text-blue-800 text-lg">@lop.MaMonNavigation?.TenMon</h3>
                    <p class="text-sm text-gray-500 font-mono mt-1">@lop.MaHp</p>
                </div>
                <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded">@lop.HocKy</span>
            </div>

            <div class="text-sm text-gray-600 mb-4 space-y-1">
                <p><i class="fa-regular fa-clock w-5 text-gray-400"></i> @lop.Thu (Tiết @lop.TietBatDau - @lop.TietKetThuc)</p>
                <p><i class="fa-solid fa-door-open w-5 text-gray-400"></i> Phòng: @lop.PhongHoc</p>
                <p><i class="fa-solid fa-users w-5 text-gray-400"></i> Sĩ số: @lop.SiSoHienTai / @lop.SiSoToiDa</p>
            </div>

            <a href="/GiangVien/DiemDanh/ChiTiet?maHp=@lop.MaHp" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 rounded-lg transition-colors">
                <i class="fa-solid fa-check-to-slot mr-1"></i> Điểm danh lớp
            </a>
        </div>
    }
</div>