@model IEnumerable<QLSinhVien.Models.MonHoc>
@{
    ViewData["Title"] = "Đăng ký môn giảng dạy";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="bg-white p-6 rounded shadow-sm">
    <h2 class="text-2xl font-bold mb-2">Danh sách Môn học thuộc @ViewBag.TenKhoaCuaGV</h2>
    <p class="text-gray-500 mb-6">Vui lòng chọn môn học bạn muốn mở lớp trong học kỳ này.</p>

    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-gray-100 text-gray-700">
                <th class="p-3 border-b">Mã Môn</th>
                <th class="p-3 border-b">Tên Môn Học</th>
                <th class="p-3 border-b text-center">Số Tín Chỉ</th>
                <th class="p-3 border-b text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="p-3 border-b text-blue-600 font-semibold">@item.MaMon</td>
                    <td class="p-3 border-b">@item.TenMon</td>
                    <td class="p-3 border-b text-center">@item.SoTinChi</td>
                    <td class="p-3 border-b text-center">
                        <!-- Bấm nút này sẽ chuyển sang form nhập Thời gian, Phòng học để lưu vào bảng HocPhanMo -->
                        <a href="/GiangVien/GiangVien/MoLop?maMon=@item.MaMon" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">
                            <i class="fa-solid fa-plus mr-1"></i> Đăng ký dạy
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>