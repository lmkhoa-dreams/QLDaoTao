<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Đào Tạo</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>

    <!-- THANH HEADER TRÊN CÙNG -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">

            <!-- BÊN TRÁI: Logo -->
            <a href="/SinhVien/SinhVien/Index" class="flex items-center gap-3 text-blue-600 hover:text-blue-700 transition-colors text-decoration-none">
                <i class="fa-solid fa-building-columns text-2xl"></i>
                <div class="hidden md:block">
                    <p class="font-bold text-sm leading-tight uppercase">Trường Đại Học</p>
                    <p class="font-bold text-[17px] leading-tight uppercase text-blue-800">Cổng Thông Tin</p>
                </div>
            </a>

            <!-- BÊN PHẢI: Menu Dropdown Avatar (Chỉ hiện khi đăng nhập) -->
            <div class="flex items-center shrink-0">
                @if (ViewBag.HoTen != null)
                {
                    <div class="relative inline-block text-left">

                        <!-- Nút bấm hiển thị Avatar & Tên -->
                        <div id="user-menu-btn" class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-gray-50 rounded-full border border-transparent hover:border-gray-200 transition-all">
                            <img src="https://ui-avatars.com/api/?name=@ViewBag.HoTen&background=random" class="w-9 h-9 rounded-full object-cover shadow-sm border border-gray-200" alt="Avatar" />
                            <span class="text-gray-700 text-[15px] font-medium hidden sm:block">@ViewBag.HoTen</span>
                            <i class="fa-solid fa-caret-down text-gray-500 text-xs ml-1 mr-1"></i>
                        </div>

                        <!-- Bảng Menu Thả xuống (Mặc định ẩn) -->
                        <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-100 rounded shadow-lg z-50">
                            <a href="/SinhVien/HoSo" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-500 border-b border-gray-100 transition-colors">
                                <i class="fa-regular fa-user mr-2"></i>Thông tin cá nhân
                            </a>
                            <!-- Nút Đổi mật khẩu kích hoạt hàm mở Pop-up -->
                            <a href="#" onclick="openPasswordModal(event)" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-500 border-b border-gray-100 transition-colors">
                                <i class="fa-solid fa-key mr-2"></i>Đổi mật khẩu
                            </a>
                            <a href="/Account/Logout" class="block px-4 py-3 text-sm text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors font-medium">
                                <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>Đăng xuất
                            </a>
                        </div>
                    </div>
                }
            </div>

        </div>
    </header>

    <!-- NỘI DUNG CHÍNH CỦA TRANG INDEX SẼ NẰM BÊN DƯỚI HEADER NÀY -->
    <div class="p-4 md:p-8 pt-6">
        @RenderBody()
    </div>

    <!-- MODAL (POP-UP) ĐỔI MẬT KHẨU NHƯ HÌNH MẪU   -->
    <div id="passwordModal" class="hidden fixed inset-0 z-[100] bg-black/50 flex items-center justify-center backdrop-blur-sm transition-all duration-300">
        <div class="bg-white rounded-lg shadow-2xl w-full max-w-md relative overflow-hidden transform transition-all">

            <!-- Nút X tắt modal ở góc phải -->
            <button onclick="closePasswordModal()" class="absolute top-0 right-0 bg-[#0ea5e9] hover:bg-blue-600 text-white w-10 h-10 flex items-center justify-center rounded-bl-lg transition-colors z-10">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <!-- Ruột Form -->
            <div class="p-8 mt-2">

                <!-- KHUNG HIỂN THỊ THÔNG BÁO BÊN TRONG MODAL -->
                <div id="pwdAlert" class="hidden p-3 mb-4 rounded border-l-4 text-[14.5px] font-medium shadow-sm" role="alert"></div>

                <form id="formChangePwd" onsubmit="return submitChangePwd(event)" class="space-y-5">

                    <div>
                        <label class="block text-[14.5px] text-gray-700 mb-1.5 font-medium">Mật khẩu cũ <span class="text-red-500">(*)</span></label>
                        <input type="password" name="oldPassword" placeholder="Nhập mật khẩu cũ" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400 text-sm transition-all" />
                    </div>

                    <div>
                        <label class="block text-[14.5px] text-gray-700 mb-1.5 font-medium">Mật khẩu mới <span class="text-red-500">(*)</span></label>
                        <input type="password" name="newPassword" placeholder="Nhập mật khẩu mới" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400 text-sm transition-all" />
                    </div>

                    <div>
                        <label class="block text-[14.5px] text-gray-700 mb-1.5 font-medium">Xác nhận mật khẩu <span class="text-red-500">(*)</span></label>
                        <input type="password" name="confirmPassword" placeholder="Xác nhận lại mật khẩu" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400 text-sm transition-all" />
                    </div>

                    <!-- Nút Lưu -->
                    <div class="flex justify-end pt-4">
                        <button type="submit" class="bg-[#0ea5e9] hover:bg-blue-600 text-white font-medium py-2.5 px-8 rounded transition-colors shadow-md text-sm">
                            Lưu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT ĐỂ MỞ/ĐÓNG MENU VÀ XỬ LÝ AJAX FORM -->
    <script>
        const btn = document.getElementById('user-menu-btn');
        const menu = document.getElementById('user-dropdown');
        const pwModal = document.getElementById('passwordModal');
        const pwdForm = document.getElementById('formChangePwd');
        const pwdAlert = document.getElementById('pwdAlert');

        // 1. Script cho Dropdown Menu
        if (btn && menu) {
            btn.addEventListener('click', function (event) {
                menu.classList.toggle('hidden');
                event.stopPropagation();
            });

            document.addEventListener('click', function (event) {
                if (!btn.contains(event.target) && !menu.contains(event.target)) {
                    menu.classList.add('hidden');
                }
            });
        }

        // 2. Bật Pop-up Đổi mật khẩu
        function openPasswordModal(e) {
            e.preventDefault();
            pwModal.classList.remove('hidden');
            if (menu) menu.classList.add('hidden');
        }

        // 3. Đóng Pop-up và XÓA TRẮNG FORM/THÔNG BÁO
        function closePasswordModal() {
            pwModal.classList.add('hidden');
            pwdAlert.classList.add('hidden'); // Ẩn thông báo đi
            pwdForm.reset(); // Xóa trắng các ô nhập
        }

        if (pwModal) {
            pwModal.addEventListener('click', function(e) {
                if (e.target === pwModal) {
                    closePasswordModal();
                }
            });
        }

        // 4. XỬ LÝ AJAX FORM 
        function submitChangePwd(e) {
            e.preventDefault(); // Ngăn văng trang

            const formData = new FormData(pwdForm);

            // Gửi dữ liệu ngầm lên server
            fetch('/Account/ChangePassword', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                // Reset giao diện báo lỗi
                pwdAlert.classList.remove('hidden', 'bg-green-100', 'border-green-500', 'text-green-700', 'bg-red-100', 'border-red-500', 'text-red-700');

                // In chữ vào thông báo
                pwdAlert.textContent = data.message;

                if (data.success) {
                    // Xanh lá (Thành công)
                    pwdAlert.classList.add('bg-green-100', 'border-green-500', 'text-green-700');
                    pwdForm.reset();
                } else {
                    // Đỏ (Thất bại)
                    pwdAlert.classList.add('bg-red-100', 'border-red-500', 'text-red-700');
                }
            })
            .catch(error => {
                console.error('Lỗi:', error);
                pwdAlert.classList.remove('hidden');
                pwdAlert.classList.add('bg-red-100', 'border-red-500', 'text-red-700');
                pwdAlert.textContent = "Có lỗi xảy ra, vui lòng thử lại!";
            });

            return false;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>