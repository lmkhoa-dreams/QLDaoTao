@model IEnumerable<QLSinhVien.Models.HocPhanMo>
@{
    ViewData["Title"] = "Lịch học, lịch thi theo tuần";
    Layout = "~/Areas/SinhVien/Views/Shared/_SinhVienLayout.cshtml";

    DateTime[] tuanNay = ViewBag.TuanNay;
    DateTime currentDate = ViewBag.CurrentDate;
    string[] thuTieuDe = { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ nhật" };
}

<style>
    @@media print {
        .no-print, header, footer, nav

    {
        display: none !important;
    }

    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    }
</style>

<div class="bg-white p-4 min-h-screen">

    <div class="flex flex-wrap items-center justify-between bg-gray-100 p-3 mb-4 rounded border border-gray-200 shadow-sm no-print">
        <div class="flex items-center gap-4">
            <h2 class="text-xl font-bold text-gray-700">Lịch học, lịch thi theo tuần</h2>
            <div class="flex gap-4 text-sm text-gray-600 ml-4 font-medium">
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="radio" name="loai" class="w-4 h-4 text-blue-500"> Tất cả</label>
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="radio" name="loai" checked class="w-4 h-4 text-blue-500"> Lịch học</label>
                <label class="flex items-center gap-1.5 cursor-pointer"><input type="radio" name="loai" class="w-4 h-4 text-blue-500"> Lịch thi</label>
            </div>
            <div class="flex items-center ml-2">
                <input type="text" value="@currentDate.ToString("dd/MM/yyyy")" class="border border-gray-300 px-3 py-1.5 w-32 text-sm outline-none text-center font-medium bg-white" readonly>
                <span class="bg-gray-200 border border-gray-300 border-l-0 px-3 py-1.5 text-gray-600"><i class="fa-regular fa-calendar"></i></span>
            </div>
        </div>

        <!-- Nút bấm chuyển ngày -->
        <div class="flex gap-2">
            <a href="/SinhVien/LichHoc/Index" class="bg-[#0ea5e9] hover:bg-blue-600 text-white px-3.5 py-1.5 text-sm font-medium rounded transition-colors block text-decoration-none shadow-sm"><i class="fa-solid fa-calendar-day mr-1"></i> Hiện tại</a>
            <button onclick="window.print()" class="bg-[#0ea5e9] hover:bg-blue-600 text-white px-3.5 py-1.5 text-sm font-medium rounded transition-colors shadow-sm"><i class="fa-solid fa-print mr-1"></i> In lịch</button>
            <a href="/SinhVien/LichHoc/Index?date=@ViewBag.PrevWeek" class="bg-[#0ea5e9] hover:bg-blue-600 text-white px-3.5 py-1.5 text-sm font-medium rounded transition-colors block text-decoration-none shadow-sm">< Trở về</a>
            <a href="/SinhVien/LichHoc/Index?date=@ViewBag.NextWeek" class="bg-[#0ea5e9] hover:bg-blue-600 text-white px-3.5 py-1.5 text-sm font-medium rounded transition-colors block text-decoration-none shadow-sm">Tiếp ></a>
        </div>
    </div>
    
    <!-- Bảng lịch học -->
    <div class="overflow-x-auto shadow-sm">
        <table class="w-full border-collapse border border-gray-300 min-w-[1000px] table-fixed">
            <thead>
                <tr class="bg-blue-50 text-blue-700 border-b border-gray-300">
                    <th class="w-20 p-2 border-r border-gray-300 font-bold">Ca học</th>
                    @for (int i = 0; i < 7; i++)
                    {
                        <th class="p-2 border-r border-gray-300 text-center font-bold">
                            @thuTieuDe[i]<br />
                            <span class="text-xs font-normal text-gray-500">@tuanNay[i].ToString("dd/MM/yyyy")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <!-- HÀM C# RENDER TỪNG Ô BÊN TRONG RAZOR -->
                @{
                    void RenderCell(string thu, string ca)
                    {
                        // Set nền lưới (grid) caro mờ mờ cho giống thật
                    <td class="border-r border-b border-gray-300 p-1.5 align-top relative bg-[url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAFElEQVQIW2NkYGD4z8DAwMgAI0AMDA4LA/4qO+wAAAAASUVORK5CYII=')]">
                        @{
                            if (Model != null)
                            {
                                // Lọc môn theo đúng Thứ
                                var cacMonTrongNgay = Model.Where(m => m.Thu == thu);

                                // Lọc môn theo đúng Ca học (dựa vào Tiết Bắt Đầu)
                                if (ca == "Sáng") cacMonTrongNgay = cacMonTrongNgay.Where(m => m.TietBatDau <= 5);
                                else if (ca == "Chiều") cacMonTrongNgay = cacMonTrongNgay.Where(m => m.TietBatDau > 5 && m.TietBatDau <= 12);
                                else if (ca == "Tối") cacMonTrongNgay = cacMonTrongNgay.Where(m => m.TietBatDau > 12);

                                // Vẽ từng cục môn học trong ô đó
                                foreach (var lop in cacMonTrongNgay)
                                {
                                    <div class="bg-[#93c5fd] border border-blue-400 p-2 mb-2 rounded shadow-sm text-xs text-blue-900 leading-snug">
                                        <p class="font-bold mb-1 text-[13px]">@lop.MaMonNavigation?.TenMon</p>
                                        <p class="mb-0.5 font-medium">@lop.MaHp</p>
                                        <p class="mb-0.5">Tiết: @lop.TietBatDau - @lop.TietKetThuc</p>
                                        <p class="mb-0.5">Phòng: <span class="font-medium">@lop.PhongHoc</span></p>
                                        <p>GV: @(lop.MaGvNavigation != null ? lop.MaGvNavigation.MaGv : lop.MaGv)</p>
                                    </div>
                                }
                            }
                        }
                    </td>
                }
            }

            <!-- GỌI HÀM VẼ TỪNG CA -->
            <tr class="h-44">
                <td class="bg-yellow-50/50 border-r border-b border-gray-300 text-center font-bold text-gray-700">Sáng</td>
                @foreach (var thu in thuTieuDe) { RenderCell(thu, "Sáng"); }
            </tr>

            <tr class="h-44">
                <td class="bg-yellow-50/50 border-r border-b border-gray-300 text-center font-bold text-gray-700">Chiều</td>
                @foreach (var thu in thuTieuDe) { RenderCell(thu, "Chiều"); }
            </tr>

            <tr class="h-28">
                <td class="bg-yellow-50/50 border-r border-b border-gray-300 text-center font-bold text-gray-700">Tối</td>
                @foreach (var thu in thuTieuDe) { RenderCell(thu, "Tối"); }
            </tr>
            </tbody>
        </table>
    </div>
    <div class="mt-4 flex gap-6 text-xs text-gray-600 flex-wrap no-print font-medium">
        <div class="flex items-center gap-1.5"><span class="block w-10 h-4 bg-gray-200 border border-gray-300"></span> Lịch học lý thuyết</div>
        <div class="flex items-center gap-1.5"><span class="block w-10 h-4 bg-green-500 border border-green-600"></span> Lịch học thực hành</div>
        <div class="flex items-center gap-1.5"><span class="block w-10 h-4 bg-[#93c5fd] border border-blue-400"></span> Lịch học trực tuyến</div>
        <div class="flex items-center gap-1.5"><span class="block w-10 h-4 bg-yellow-200 border border-yellow-300"></span> Lịch thi</div>
    </div>
</div>