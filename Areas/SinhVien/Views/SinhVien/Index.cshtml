@{
    Layout = "~/Areas/SinhVien/Views/Shared/_SinhVienLayout.cshtml";
    ViewData["Title"] = "Dashboard Sinh Viên";
}

<div class="max-w-7xl mx-auto space-y-6">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-2 bg-white rounded-lg shadow-sm p-6">
            <h2 class="text-2xl font-bold text-gray-600 mb-4">Thông tin sinh viên</h2>
            <hr class="border-gray-100 mb-6" />

            <div class="flex flex-col md:flex-row items-center md:items-start gap-8">

                <div class="flex flex-col items-center shrink-0">
                    <div class="w-32 h-32 rounded-full bg-[#fde047] flex items-center justify-center shadow-md mb-3 border-4 border-white">
                        <span class="text-5xl font-normal text-black">@ViewBag.AvatarChar</span>
                    </div>
                    <a href="/SinhVien/SinhVien/HoSo" class="text-blue-500 hover:text-blue-700 text-sm font-medium">Xem chi tiết</a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-12 w-full text-sm mt-2">
                    <div class="flex"><span class="text-gray-500 w-28">MSSV:</span><span class="font-bold text-gray-800">@ViewBag.MSSV</span></div>
                    <div class="flex"><span class="text-gray-500 w-28">Lớp học:</span><span class="font-bold text-gray-800">@ViewBag.LopHoc</span></div>

                    <div class="flex"><span class="text-gray-500 w-28">Họ tên:</span><span class="font-bold text-gray-800">@ViewBag.HoTen</span></div>
                    <div class="flex"><span class="text-gray-500 w-28">Khóa học:</span><span class="font-bold text-gray-800">@ViewBag.KhoaHoc</span></div>

                    <div class="flex"><span class="text-gray-500 w-28">Giới tính:</span><span class="font-bold text-gray-800">@ViewBag.GioiTinh</span></div>
                    <div class="flex"><span class="text-gray-500 w-28">Bậc đào tạo:</span><span class="font-bold text-gray-800">Đại học</span></div>

                    <div class="flex"><span class="text-gray-500 w-28">Ngày sinh:</span><span class="font-bold text-gray-800">@ViewBag.NgaySinh</span></div>
                    <div class="flex"><span class="text-gray-500 w-28">Đào tạo:</span><span class="font-bold text-gray-800">Chính quy 3.5 năm</span></div>

                    <div class="flex"><span class="text-gray-500 w-28">Nơi sinh:</span><span class="font-bold text-gray-800">Đồng Nai</span></div>
                    <div class="flex"><span class="text-gray-500 w-28">Ngành:</span><span class="font-bold text-gray-800">@ViewBag.Nganh</span></div>
                </div>

            </div>
        </div>

        <div class="flex flex-col gap-6">
            <div class="bg-white rounded-lg shadow-sm p-6 relative h-full">
                <p class="text-gray-500 text-sm font-medium mb-2">Nhắc nhở mới, chưa xem</p>
                <p class="text-4xl font-bold text-gray-700 mb-4">0</p>
                <a href="/SinhVien/LichHoc" class="text-blue-500 hover:text-blue-700 text-sm font-medium">Xem chi tiết</a>
                <div class="absolute top-6 right-6 w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-400">
                    <i class="fa-regular fa-bell"></i>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 h-full">
                <div class="bg-[#e6f7ff] rounded-lg p-4 relative flex flex-col justify-between">
                    <p class="text-blue-500 text-xs font-medium mb-2">Lịch học trong tuần</p>
                    <p class="text-3xl font-bold text-blue-500 mb-2">6</p>
                    <a href="/SinhVien/LichHoc" class="text-blue-500 hover:text-blue-700 text-xs font-medium">Xem chi tiết</a>
                    <div class="absolute top-4 right-4 w-8 h-8 rounded-full border border-blue-200 flex items-center justify-center text-blue-400 bg-white">
                        <i class="fa-regular fa-calendar"></i>
                    </div>
                </div>
                <div class="bg-[#fff7e6] rounded-lg p-4 relative flex flex-col justify-between">
                    <p class="text-orange-500 text-xs font-medium mb-2">Lịch thi trong tuần</p>
                    <p class="text-3xl font-bold text-orange-500 mb-2">0</p>
                    <a href="/SinhVien/LichHoc" class="text-orange-500 hover:text-orange-700 text-xs font-medium">Xem chi tiết</a>
                    <div class="absolute top-4 right-4 w-8 h-8 rounded-full border border-orange-200 flex items-center justify-center text-orange-400 bg-white">
                        <i class="fa-regular fa-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-wrap gap-4">
        <a href="/SinhVien/SinhVien/HoSo" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-regular fa-id-badge text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Thông tin<br />sinh viên</span>
        </a>

        <a href="/SinhVien/KetQuaHocTap" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-chart-column text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Kết quả<br />học tập</span>
        </a>

        <a href="/SinhVien/DangKyHocPhan" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-layer-group text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-blue-500 text-center px-2">Đăng ký<br />học phần</span>
        </a>

        <a href="/SinhVien/ThongKeDiemDanh/Index" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-calendar-check text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Thống kê<br />điểm danh</span>
        </a>

        <a href="/SinhVien/ThanhToan/Index" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-file-invoice-dollar text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Thanh toán<br />trực tuyến</span>
        </a>

        <a href="@Url.Action("Upload", "GiayTo", new { area = "" })" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-file-arrow-up text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Cập nhật<br />thông tin</span>
        </a>

        <a href="@Url.Action("HoSoSinhVien", "GiayTo", new { area = "" })" class="card-hover bg-white w-40 h-32 rounded-lg shadow-sm flex flex-col items-center justify-center gap-3 border border-transparent hover:border-blue-100 text-decoration-none">
            <i class="fa-solid fa-folder-open text-3xl text-blue-500"></i>
            <span class="text-sm font-medium text-gray-600 text-center px-2">Hồ sơ<br />sinh viên</span>
        </a>
    </div>
    </div>